{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltess.local/schemas/c3-error.schema.json",
  "title": "C3 API Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "request_id"],
      "properties": {
        "code": {
          "enum": [
            "VALIDATION_ERROR",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "NOT_FOUND",
            "CONFLICT",
            "LOW_CONFIDENCE",
            "PROVIDER_ERROR",
            "RATE_LIMITED",
            "INSUFFICIENT_DATA"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    }
  }
}
