# Runtime
NODE_ENV=development
APP_ENV=development
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql://voltra:voltra@localhost:5432/voltra

# Redis + BullMQ
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (foto/suara privat)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=voltra-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Auth / OTP (penyedia belum diputuskan, O27)
OTP_PROVIDER=
OTP_API_KEY=
SESSION_SECRET=

# AI Gateway
# AI_MODE=mock hanya untuk pengembangan. Pilot/produksi wajib hybrid/live.
AI_MODE=mock
# Skenario default: success | low_confidence | insufficient_data | provider_error.
# Skenario juga bisa dipaksa per request lewat header x-ai-scenario di lingkungan dev.
AI_SCENARIO=success
AI_MODE_OCR_METER=mock
AI_MODE_OCR_LABEL=mock
AI_MODE_OCR_TOKEN=mock
AI_MODE_STT_EXTRACT=mock
AI_MODE_ESTIMATE=mock
AI_MODE_ESTIMATE_CROSSCHECK=mock
AI_MODE_RECOMMEND=mock
AI_MODE_EXPLAIN=mock
AI_MODE_ASK=mock

# AI Provider API Keys (live mode)
# Get keys from: https://aistudio.google.com/app/apikey (Gemini)
#                https://www.assemblyai.com/dashboard (AssemblyAI)
GEMINI_API_KEY=
ASSEMBLYAI_API_KEY=

# Legacy/fallback
AI_PROVIDER_API_KEY=

# Pembayaran (penyedia belum diputuskan)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
